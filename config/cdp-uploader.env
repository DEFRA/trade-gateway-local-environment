# See https://github.com/DEFRA/cdp-uploader/blob/main/src/config/index.js
NODE_ENV=development
PORT=7337
# The uploader builds absolute upload URLs from this in development; trade-gateway only uses the path.
APP_BASE_URL=http://cdp-uploader:7337
AWS_EMF_ENVIRONMENT=Local
REDIS_HOST=redis
USE_SINGLE_INSTANCE_CACHE=true
SQS_ENDPOINT=http://floci:4566
S3_ENDPOINT=http://floci:4566
# The scan is mocked locally: files whose name matches MOCK_VIRUS_REGEX (default .*virus.*) are rejected.
MOCK_VIRUS_SCAN_ENABLED=true
MOCK_VIRUS_RESULT_DELAY=3
# Buckets the uploader may deliver scanned files to.
CONSUMER_BUCKETS=trade-gateway-documents
