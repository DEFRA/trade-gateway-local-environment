ASPNETCORE_ENVIRONMENT=Development
Mongo__DatabaseUri=mongodb://mongodb:27017/?tls=false
PORT=8080

# Four TRACES endpoints from one instance. The default is EU acceptance — the same default the
# service is deployed with, so a target name means the same thing here as it does on CDP. It is
# reached by the POC's own URLs (/ched/{id}); the rest add a first path segment (/mock/ched/{id}).
# A target states only what it changes and inherits the rest.
TracesNt__BaseUrl=${TRACES_NT_BASE_URL:-https://webgate.acceptance.ec.europa.eu:443/tracesnt/ws}

# Real TRACES credentials, inherited by the proxy target because it reaches the same place. Leave
# them unset and the default and proxy resolve but fail to authenticate.
TracesNt__Clients__certificate__Username=${TRACES_NT_CREDENTIALS_DEFAULT_USERNAME:-}
TracesNt__Clients__certificate__AuthenticationKey=${TRACES_NT_CREDENTIALS_DEFAULT_AUTHENTICATION_KEY:-}
TracesNt__Clients__certificate__WebServiceClientId=${TRACES_NT_CREDENTIALS_DEFAULT_WEB_SERVICE_CLIENT_ID:-}
TracesNt__Clients__certex__Username=${TRACES_NT_CREDENTIALS_CUSTOMS_USERNAME:-}
TracesNt__Clients__certex__AuthenticationKey=${TRACES_NT_CREDENTIALS_CUSTOMS_AUTHENTICATION_KEY:-}
TracesNt__Clients__certex__WebServiceClientId=${TRACES_NT_CREDENTIALS_CUSTOMS_WEB_SERVICE_CLIENT_ID:-}

# The SOAP simulator, which serves the five service paths from the root. It genuinely validates
# WS-Security, so these must match the accounts it expects (Simulator:Credentials in the stub's
# appsettings.json). certex maps to the customs account because CustomsCertexChedServiceV06
# authenticates separately on both sides.
TracesNt__Targets__simulator__BaseUrl=http://trade-tracesnt-stub:8080
TracesNt__Targets__simulator__Clients__certificate__Username=simulator-user
TracesNt__Targets__simulator__Clients__certificate__AuthenticationKey=simulator-auth-key
TracesNt__Targets__simulator__Clients__certificate__WebServiceClientId=simulator-client-id
TracesNt__Targets__simulator__Clients__certex__Username=simulator-customs-user
TracesNt__Targets__simulator__Clients__certex__AuthenticationKey=simulator-customs-auth-key
TracesNt__Targets__simulator__Clients__certex__WebServiceClientId=simulator-customs-client-id

# Canned XML from the stub's WireMock, matched on SOAPAction. The values below are never checked,
# but they have to be set: WireMock matches on a well-formed UsernameToken being present, and the
# POC omits the security header altogether when a credential is blank. Inheriting the real
# credentials would leave this target broken on any machine that has none.
TracesNt__Targets__mock__BaseUrl=http://trade-tracesnt-stub:8080/mock/tracesnt/ws
TracesNt__Targets__mock__Clients__certificate__Username=mock-user
TracesNt__Targets__mock__Clients__certificate__AuthenticationKey=mock-auth-key
TracesNt__Targets__mock__Clients__certificate__WebServiceClientId=mock-client-id
TracesNt__Targets__mock__Clients__certex__Username=mock-customs-user
TracesNt__Targets__mock__Clients__certex__AuthenticationKey=mock-customs-auth-key
TracesNt__Targets__mock__Clients__certex__WebServiceClientId=mock-customs-client-id

# The stub's recording proxy: the same destination as the default, but observable. Inherits the
# real credentials above, because it is the same server answering.
TracesNt__Targets__proxy__BaseUrl=http://trade-tracesnt-stub:8080/proxy/tracesnt/ws

# Nothing in this stack serves the imports data API. Set so the endpoints that use it fail with a
# refused connection rather than a null reference.
DataApi__BaseAddress=http://trade-imports-data-api:8080
