ASPNETCORE_ENVIRONMENT=Development
AUTHENTICATION__COGNITO__AUTHORITY=http://localhost:8080/local/cognito
AUTHENTICATION__STS__AUTHORITY=http://localhost:8080/local/sts
Mongo__DatabaseUri=mongodb://mongodb:27017/?tls=false
PORT=8080
# Defaults to the stub's SOAP simulator, which serves the service paths from the root. It genuinely
# validates WS-Security, so the default credentials are the accounts it expects (Simulator:Credentials
# in the stub's appsettings.json). Set TRACES_NT_BASE_URL and the credentials to reach EU acceptance.
TracesNt__BaseUrl=${TRACES_NT_BASE_URL:-http://trade-tracesnt-stub:8080}
TracesNt__CustomsOfficeReferenceNumber=${TRACES_NT_CUSTOMS_OFFICE_REFERENCE_NUMBER:-XI000002}
TracesNt__Credentials__Default__Username=${TRACES_NT_CREDENTIALS_DEFAULT_USERNAME:-simulator-user}
TracesNt__Credentials__Default__AuthenticationKey=${TRACES_NT_CREDENTIALS_DEFAULT_AUTHENTICATION_KEY:-simulator-auth-key}
TracesNt__Credentials__Default__WebServiceClientId=${TRACES_NT_CREDENTIALS_DEFAULT_WEB_SERVICE_CLIENT_ID:-simulator-client-id}
TracesNt__Credentials__Customs__Username=${TRACES_NT_CREDENTIALS_CUSTOMS_USERNAME:-simulator-customs-user}
TracesNt__Credentials__Customs__AuthenticationKey=${TRACES_NT_CREDENTIALS_CUSTOMS_AUTHENTICATION_KEY:-simulator-customs-auth-key}
TracesNt__Credentials__Customs__WebServiceClientId=${TRACES_NT_CREDENTIALS_CUSTOMS_WEB_SERVICE_CLIENT_ID:-simulator-customs-client-id}
